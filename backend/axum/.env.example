# Axon Rust/Axum backend
# Copy to .env for local development. Never commit real .env files.

# Runtime
AXON_ENV=development
RUST_LOG=axon_api=info,tower_http=info
PORT=8080
# Optional: overrides PORT when set. Leave unset on managed hosts.
# AXON_HOST=127.0.0.1
# AXON_PORT=8080

# Authoritative relational state (use a persistent mounted path in production)
AXON_DATABASE_URL=sqlite://axon.db

# Google OAuth ID-token verification (required to start the API)
GOOGLE_OAUTH_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
# Optional verified Google emails with platform-admin access.
# AXON_PLATFORM_ADMIN_EMAILS=admin@example.com

# MongoDB memory/document storage
# Optional in development; required automatically when AXON_ENV=production.
AXON_MONGODB_URI=mongodb://127.0.0.1:27017
AXON_MONGODB_DATABASE=axon
AXON_MONGODB_COLLECTION=memory_documents
AXON_MONGODB_MAX_POOL_SIZE=20
AXON_MONGODB_CONNECT_TIMEOUT_MS=10000
AXON_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# AXON_MEMORY_DOCUMENTS_REQUIRED=true

# Optional Qoin vector service integration
# QOIN_API_URL=http://127.0.0.1:8090

# Keep simulator ingress disabled unless explicitly testing locally.
AXON_ENABLE_SIMULATOR=false

# Optional serialized, versioned Qoin scoring policy JSON.
# AXON_QOIN_MEMORY_SCORING_CONFIG=
