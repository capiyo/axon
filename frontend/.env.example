# Axon frontend environment reference
# Copy the relevant variables into the app-specific .env file.
#
# Web: frontend/apps/web/.env
# Mobile: frontend/apps/mobile/.env
#
# IMPORTANT: VITE_* and EXPO_PUBLIC_* values are embedded in client apps.
# They are public configuration, NOT secrets. Never put private API keys,
# MongoDB credentials, service-account JSON,or provider secrets here.

# React web (Vite)
VITE_GOOGLE_CLIENT_ID=
VITE_AXON_API_URL=http://127.0.0.1:8080

# React Native mobile (Expo)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_AXON_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Desktop Tauri uses the web frontend configuration unless a dedicated
# desktop-specific environment mapping is introduced.
